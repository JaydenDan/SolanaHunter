# 基本配置
LOG_DIR=logs

# Redis配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_DECODE_RESPONSES=True
REDIS_MAX_CONNECTIONS=10
REDIS_TIMEOUT=5

# MySQL配置
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=your_database
MYSQL_CHARSET=utf8mb4
MYSQL_POOL_SIZE=5
MYSQL_TIMEOUT=10

# Twitter API配置
TWITTER_COOKIE_PATH=twitter_cookies.txt
TWITTER_PROXY=http://127.0.0.1:7890
TWITTER_ACCOUNT_FILE=twitter_account.xlsx

# 区块链监听配置
BLOCKCHAIN_WEBSOCKET_URL=wss://pumpportal.fun/api/data

# 区块链RPC配置
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# 钉钉通知配置
DINGTALK_TOKEN=your_dingtalk_token
DINGTALK_CLIENT_ID=your_dingtalk_client_id
DINGTALK_CLIENT_SECRET=your_dingtalk_client_secret

# Discord配置
DISCORD_TOKEN=your_discord_token
DISCORD_PROXY=http://localhost:7890
DISCORD_CHANNEL_TEST=0
DISCORD_CHANNEL_ALL_TWITTER=0
DISCORD_CHANNEL_FOUNDER_TWITTER=0
DISCORD_CHANNEL_1000_3000_FANS=0
DISCORD_CHANNEL_3000_5000_FANS=0
DISCORD_CHANNEL_5000_10000_FANS=0
DISCORD_CHANNEL_10000_PLUS_FANS=0
DISCORD_CHANNEL_SYSTEM=0
DISCORD_CHANNEL_START_LAUNCH=0
DISCORD_CHANNEL_HAS_SCORE=0
DISCORD_CHANNEL_DEV_BALANCE_50=0
DISCORD_CHANNEL_DEV_BALANCE_20=0 