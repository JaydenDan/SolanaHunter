{
  "rules": [
    {
      "id": "twitter_all_notify",
      "name": "推特所有通知",
      "description": "代币有推特帖子就推送",
      "enable": true,
      "condition": {
        "type": "exists",
        "field": "social"
      },
      "action": {
        "type": "notify",
        "channel": 1345252024413065322
      }
    },
    {
      "id": "founder_twitter",
      "name": "创始人发币（推特）",
      "description": "当创始人发推发布代币时触发",
      "enable": true,
      "condition": {
        "type": "and",
        "conditions": [
          {
            "type": "exists",
            "field": "social"
          },
          {
            "type": "or",
            "conditions": [
              {
                "type": "and",
                "conditions": [
                  {
                    "type": "string_contains",
                    "source_field": "social.user.name",
                    "target_field": "name"
                  },
                  {
                    "type": "exists",
                    "field": "social.user.display_url"
                  },
                  {
                    "type": "not",
                    "condition": {
                      "type": "string_contains",
                      "source_field": "social.user.expanded_url",
                      "value": "t.me"
                    }
                  }
                ]
              },
              {
                "type": "and",
                "conditions": [
                  {
                    "type": "string_contains",
                    "source_field": "social.user.screen_name",
                    "target_field": "name"
                  },
                  {
                    "type": "exists",
                    "field": "social.user.display_url"
                  },
                  {
                    "type": "not",
                    "condition": {
                      "type": "string_contains",
                      "source_field": "social.user.expanded_url",
                      "value": "t.me"
                    }
                  }
                ]
              },
              {
                "type": "and",
                "conditions": [
                  {
                    "type": "string_contains",
                    "source_field": "social.user.description",
                    "target_field": "name"
                  },
                  {
                    "type": "exists",
                    "field": "social.user.display_url"
                  },
                  {
                    "type": "not",
                    "condition": {
                      "type": "string_contains",
                      "source_field": "social.user.expanded_url",
                      "value": "t.me"
                    }
                  }
                ]
              },
              {
                "type": "and",
                "conditions": [
                  {
                    "type": "string_contains",
                    "source_field": "social.user.name",
                    "target_field": "symbol"
                  },
                  {
                    "type": "exists",
                    "field": "social.user.display_url"
                  },
                  {
                    "type": "not",
                    "condition": {
                      "type": "string_contains",
                      "source_field": "social.user.expanded_url",
                      "value": "t.me"
                    }
                  }
                ]
              },
              {
                "type": "and",
                "conditions": [
                  {
                    "type": "string_contains",
                    "source_field": "social.user.screen_name",
                    "target_field": "symbol"
                  },
                  {
                    "type": "exists",
                    "field": "social.user.display_url"
                  },
                  {
                    "type": "not",
                    "condition": {
                      "type": "string_contains",
                      "source_field": "social.user.expanded_url",
                      "value": "t.me"
                    }
                  }
                ]
              },
              {
                "type": "and",
                "conditions": [
                  {
                    "type": "string_contains",
                    "source_field": "social.user.description",
                    "target_field": "symbol"
                  },
                  {
                    "type": "exists",
                    "field": "social.user.display_url"
                  },
                  {
                    "type": "not",
                    "condition": {
                      "type": "string_contains",
                      "source_field": "social.user.expanded_url",
                      "value": "t.me"
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "action": {
        "type": "notify",
        "channel": 1359885957263786029
      }
    }
  ]
} 