# 基本配置
LOG_DIR=logs

# Redis配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=1
REDIS_PASSWORD=
REDIS_DECODE_RESPONSES=True
REDIS_MAX_CONNECTIONS=10
REDIS_TIMEOUT=5

# MySQL配置
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=solana_hunter
MYSQL_CHARSET=utf8mb4
MYSQL_POOL_SIZE=5
MYSQL_TIMEOUT=10

# Twitter配置
ENABLE_TWITTER_PROXY=True
TWITTER_COOKIES_FILE_PATH=twitter_cookies
TWITTER_ACCOUNT_FILE_PATH=twitter_account.xlsx
TWITTER_PROXY=http://127.0.0.1:7890


# 区块链监听配置
BLOCKCHAIN_WEBSOCKET_URL=wss://pumpportal.fun/api/data

# 区块链RPC配置
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# 规则文件夹路径
RULE_FILES_DIR_PATH=all_rules