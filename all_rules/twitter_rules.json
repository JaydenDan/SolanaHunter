{
  "rules": [
    {
      "id": "dev_balance_20_twitter",
      "name": "开发者余额超过20SOL（推特）",
      "description": "当代币开发者余额超过20 SOL且有推特发布时触发",
      "enable": true,
      "condition": {
        "type": "and",
        "conditions": [
          {
            "type": "exists",
            "field": "social"
          },
          {
            "type": ">",
            "field": "dev_balance",
            "value": 20
          }
        ]
      },
      "action": {
        "type": "notify",
        "channel": 1348662596206596199
      }
    },
    {
      "id": "founder_twitter",
      "name": "创始人发币（推特）",
      "description": "当创始人发推发布代币时触发",
      "enable": true,
      "condition": {
        "type": "and",
        "conditions": [
          {
            "type": "exists",
            "field": "social"
          },
          {
            "type": "or",
            "conditions": [
              {
                "type": "and",
                "conditions": [
                  {
                    "type": "string_contains",
                    "source_field": "social.user.name",
                    "target_field": "name"
                  },
                  {
                    "type": "exists",
                    "field": "social.user.display_url"
                  },
                  {
                    "type": "not",
                    "condition": {
                      "type": "string_contains",
                      "source_field": "social.user.expanded_url",
                      "value": "t.me"
                    }
                  }
                ]
              },
              {
                "type": "and",
                "conditions": [
                  {
                    "type": "string_contains",
                    "source_field": "social.user.screen_name",
                    "target_field": "name"
                  },
                  {
                    "type": "exists",
                    "field": "social.user.display_url"
                  },
                  {
                    "type": "not",
                    "condition": {
                      "type": "string_contains",
                      "source_field": "social.user.expanded_url",
                      "value": "t.me"
                    }
                  }
                ]
              },
              {
                "type": "and",
                "conditions": [
                  {
                    "type": "string_contains",
                    "source_field": "social.user.description",
                    "target_field": "name"
                  },
                  {
                    "type": "exists",
                    "field": "social.user.display_url"
                  },
                  {
                    "type": "not",
                    "condition": {
                      "type": "string_contains",
                      "source_field": "social.user.expanded_url",
                      "value": "t.me"
                    }
                  }
                ]
              },
              {
                "type": "and",
                "conditions": [
                  {
                    "type": "string_contains",
                    "source_field": "social.user.name",
                    "target_field": "symbol"
                  },
                  {
                    "type": "exists",
                    "field": "social.user.display_url"
                  },
                  {
                    "type": "not",
                    "condition": {
                      "type": "string_contains",
                      "source_field": "social.user.expanded_url",
                      "value": "t.me"
                    }
                  }
                ]
              },
              {
                "type": "and",
                "conditions": [
                  {
                    "type": "string_contains",
                    "source_field": "social.user.screen_name",
                    "target_field": "symbol"
                  },
                  {
                    "type": "exists",
                    "field": "social.user.display_url"
                  },
                  {
                    "type": "not",
                    "condition": {
                      "type": "string_contains",
                      "source_field": "social.user.expanded_url",
                      "value": "t.me"
                    }
                  }
                ]
              },
              {
                "type": "and",
                "conditions": [
                  {
                    "type": "string_contains",
                    "source_field": "social.user.description",
                    "target_field": "symbol"
                  },
                  {
                    "type": "exists",
                    "field": "social.user.display_url"
                  },
                  {
                    "type": "not",
                    "condition": {
                      "type": "string_contains",
                      "source_field": "social.user.expanded_url",
                      "value": "t.me"
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "action": {
        "type": "notify",
        "channel": 1345252024413065323
      }
    },
    {
      "id": "followers_under_1000",
      "name": "粉丝数低于1000（推特）",
      "description": "当推特账户粉丝数量低于1000时触发",
      "enable": true,
      "condition": {
        "type": "and",
        "conditions": [
          {
            "type": "exists",
            "field": "social"
          },
          {
            "type": "<",
            "field": "social.user.followers_count",
            "value": 1000
          }
        ]
      },
      "action": {
        "type": "notify",
        "channel": 1345252024413065322
      }
    },
    {
      "id": "followers_1000_to_3000",
      "name": "粉丝数1000-3000（推特）",
      "description": "当推特账户粉丝数量在1000到3000之间时触发",
      "enable": true,
      "condition": {
        "type": "and",
        "conditions": [
          {
            "type": "exists",
            "field": "social"
          },
          {
            "type": "in_range",
            "field": "social.user.followers_count",
            "min": 1000,
            "max": 2999
          }
        ]
      },
      "action": {
        "type": "notify",
        "channel": 1345829917472063609
      }
    },
    {
      "id": "followers_3000_to_5000",
      "name": "粉丝数3000-5000（推特）",
      "description": "当推特账户粉丝数量在3000到5000之间时触发",
      "enable": true,
      "condition": {
        "type": "and",
        "conditions": [
          {
            "type": "exists",
            "field": "social"
          },
          {
            "type": "in_range",
            "field": "social.user.followers_count",
            "min": 3000,
            "max": 4999
          }
        ]
      },
      "action": {
        "type": "notify",
        "channel": 1345830387854741646
      }
    },
    {
      "id": "followers_5000_to_10000",
      "name": "粉丝数5000-10000（推特）",
      "description": "当推特账户粉丝数量在5000到10000之间时触发",
      "enable": true,
      "condition": {
        "type": "and",
        "conditions": [
          {
            "type": "exists",
            "field": "social"
          },
          {
            "type": "in_range",
            "field": "social.user.followers_count",
            "min": 5000,
            "max": 9999
          }
        ]
      },
      "action": {
        "type": "notify",
        "channel": 1345831194050302033
      }
    },
    {
      "id": "followers_over_10000",
      "name": "粉丝数超过10000（推特）",
      "description": "当推特账户粉丝数量超过10000时触发",
      "enable": true,
      "condition": {
        "type": "and",
        "conditions": [
          {
            "type": "exists",
            "field": "social"
          },
          {
            "type": ">=",
            "field": "social.user.followers_count",
            "value": 10000
          }
        ]
      },
      "action": {
        "type": "notify",
        "channel": 1345831926191358004
      }
    }
  ]
} 